    "typescale": {
      "displayLarge":   { "font": "Roboto", "weight": 400, "size": 57, "lineHeight": 64, "tracking": -0.25 },
      "displayMedium":  { "font": "Roboto", "weight": 400, "size": 45, "lineHeight": 52, "tracking": 0 },
      "displaySmall":   { "font": "Roboto", "weight": 400, "size": 36, "lineHeight": 44, "tracking": 0 },
      "headlineLarge":  { "font": "Roboto", "weight": 400, "size": 32, "lineHeight": 40, "tracking": 0 },
      "headlineMedium": { "font": "Roboto", "weight": 400, "size": 28, "lineHeight": 36, "tracking": 0 },
      "headlineSmall":  { "font": "Roboto", "weight": 500, "size": 24, "lineHeight": 32, "tracking": 0 },
      "titleLarge":     { "font": "Roboto", "weight": 500, "size": 22, "lineHeight": 28, "tracking": 0 },
      "titleMedium":    { "font": "Roboto", "weight": 500, "size": 16, "lineHeight": 24, "tracking": 0.15 },
      "titleSmall":     { "font": "Roboto", "weight": 500, "size": 14, "lineHeight": 20, "tracking": 0.1 },
      "bodyLarge":      { "font": "Roboto", "weight": 400, "size": 16, "lineHeight": 24, "tracking": 0.5 },
      "bodyMedium":     { "font": "Roboto", "weight": 400, "size": 14, "lineHeight": 20, "tracking": 0.25 },
      "bodySmall":      { "font": "Roboto", "weight": 400, "size": 12, "lineHeight": 16, "tracking": 0.4 },
      "labelLarge":     { "font": "Roboto", "weight": 500, "size": 14, "lineHeight": 20, "tracking": 0.1 },
      "labelMedium":    { "font": "Roboto", "weight": 500, "size": 12, "lineHeight": 16, "tracking": 0.5 },
      "labelSmall":     { "font": "Roboto", "weight": 500, "size": 11, "lineHeight": 16, "tracking": 0.5 }
    },

    "shape": {
      "cornerNone":      0,
      "cornerExtraSmall": 4,
      "cornerSmall":     8,
      "cornerMedium":    12,
      "cornerLarge":     16,
      "cornerExtraLarge": 28,
      "cornerFull":      9999
    },

    "elevation": {
      "level0": "none",
      "level1": "0px 1px 2px rgba(11,59,54,0.30), 0px 1px 3px 1px rgba(11,59,54,0.15)",
      "level2": "0px 1px 2px rgba(11,59,54,0.30), 0px 2px 6px 2px rgba(11,59,54,0.15)",
      "level3": "0px 4px 8px 3px rgba(11,59,54,0.15), 0px 1px 3px rgba(11,59,54,0.30)",
      "level4": "0px 6px 10px 4px rgba(11,59,54,0.15), 0px 2px 3px rgba(11,59,54,0.30)",
      "level5": "0px 8px 12px 6px rgba(11,59,54,0.15), 0px 4px 4px rgba(11,59,54,0.30)"
    },

    "motion": {
      "easingStandard":     "cubic-bezier(0.2, 0.0, 0, 1.0)",
      "easingEmphasized":   "cubic-bezier(0.2, 0.0, 0, 1.0)",
      "easingDecelerated":  "cubic-bezier(0.05, 0.7, 0.1, 1.0)",
      "easingAccelerated":  "cubic-bezier(0.3, 0.0, 0.8, 0.15)",
      "durationShort1": 50,
      "durationShort2": 100,
      "durationShort3": 150,
      "durationShort4": 200,
      "durationMedium1": 250,
      "durationMedium2": 300,
      "durationMedium3": 350,
      "durationMedium4": 400,
      "durationLong1": 450,
      "durationLong2": 500
    },

    "spacing": {
      "0": 0,  "1": 4,  "2": 8, "3": 12, "4": 16,
      "5": 20, "6": 24, "7": 32, "8": 40, "9": 48
    }
  },

  "components": {
    "topAppBar":   { "height": 56, "largeHeight": 152, "titleStyle": "titleLarge",   "largeTitleStyle": "headlineMedium" },
    "fab":         { "size": 56, "iconSize": 24, "shape": "cornerLarge", "container": "primary" },
    "fabExtended": { "height": 56, "minWidth": 80, "shape": "cornerLarge", "labelStyle": "labelLarge" },
    "filledButton":   { "height": 40, "shape": "cornerFull", "labelStyle": "labelLarge", "container": "primary" },
    "outlinedButton": { "height": 40, "shape": "cornerFull", "labelStyle": "labelLarge", "outline": "outline" },
    "textField":   { "height": 56, "shape": "cornerExtraSmall", "labelStyle": "bodySmall" },
    "chip":        { "height": 32, "shape": "cornerSmall", "labelStyle": "labelLarge" },
    "navigationBar": { "height": 80, "indicatorShape": "cornerLarge", "indicatorContainer": "secondaryContainer" }
  }
}

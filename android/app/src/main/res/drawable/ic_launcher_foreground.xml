<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground — per brand kit M1 Marker.
  Cream (#FFF7EC) teardrop silhouette with a circular hole punched through
  the centre. The hole reveals the deep-teal background drawable behind.
  evenOdd fillType makes the inner circle subtract from the drop shape.

  108x108 viewport. The drop sits inside the 66dp safe zone so it never
  gets clipped by the various launcher masks (circle, squircle, teardrop).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cream teardrop with a hollow centre. One path with evenOdd fill:
         the outer drop is the additive shape, the inner circle is
         subtracted out so the deep-teal background shows through. -->
    <path
        android:fillColor="#FFF7EC"
        android:fillType="evenOdd"
        android:pathData="M 54,22
                          C 54,22 30,46 30,64
                          C 30,77.5 40.5,86 54,86
                          C 67.5,86 78,77.5 78,64
                          C 78,46 54,22 54,22 Z
                          M 54,52
                          A 11,11 0 1 0 54,74
                          A 11,11 0 1 0 54,52 Z" />

</vector>

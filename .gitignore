# ─── Find My Bay — top-level .gitignore ──────────────────────────────
# Sub-projects have their own .gitignore too; this file is the safety net
# for anything that should NEVER end up in the repo regardless of where.

# ─── Secrets ─────────────────────────────────────────────────────────
# Anything containing real credentials, API keys, or signing material.
.env
.env.*
!.env.example
!.env.*.example

# Backend secrets folder (Firebase service account, Telr keys, etc.)
backend/secrets/

# Android signing + service-account material
android/app/google-services.json
android/local.properties
android/key.properties
android/app/release.keystore
*.keystore
*.jks

# Vendor-admin runtime config that contains keys
vendor-admin/.env
vendor-admin/.env.local

# ─── Node / pnpm / npm ───────────────────────────────────────────────
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# ─── TypeScript / Vite build output ──────────────────────────────────
**/dist/
**/build/
**/.vite/
**/.turbo/
backend/dist/

# ─── Prisma generated client (regenerated by `prisma generate`) ──────
backend/node_modules/.prisma/
backend/prisma/dev.db*
backend/prisma/*.db
backend/prisma/*.db-journal

# ─── Android / Gradle ────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/captures/
android/.cxx/
android/.kotlin/
android/local.properties

# Android Studio / IntelliJ
.idea/
android/.idea/
**/*.iml
.idea_modules/

# ─── Editor / OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
*.code-workspace

# ─── Logs ────────────────────────────────────────────────────────────
*.log
logs/

# ─── Claude / AI tooling state ───────────────────────────────────────
.claude/
.aider*

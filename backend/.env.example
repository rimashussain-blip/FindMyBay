# Copy this file to `.env` and fill in your local values.
# .env is git-ignored.

# ---- Server ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ---- Database ----
# Matches docker-compose.yml. Override if you run Postgres elsewhere.
DATABASE_URL=postgresql://fmb:fmb_dev@localhost:5432/findmybay?schema=public

# ---- JWT ----
# Generate strong secrets for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_for_production_minimum_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_for_production_minimum_32_chars
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ---- OTP ----
# In dev we log OTPs to the console (no SMS spend). Set to "console" or "unifonic".
OTP_DELIVERY=console
OTP_TTL_MIN=5
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_ATTEMPTS=5

# ---- CORS ----
# Comma-separated list of origins allowed to call the API. * is fine for dev.
CORS_ORIGINS=*

# ---- Maps & Push ----
# Leave empty to use mock providers (dev). Set GOOGLE_MAPS_API_KEY to enable
# real Distance Matrix calls for the smart-alert engine. Set
# FIREBASE_SERVICE_ACCOUNT_PATH to a downloaded service account JSON file to
# enable real FCM push.
GOOGLE_MAPS_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ---- Payments ----
# `mock` is the local-hosted-page driver for dev (no third-party calls).
# `telr` calls the Telr hosted-page API; requires the credentials below.
PAYMENT_PROVIDER=mock
# Public origin of this API. The processor redirects/webhooks back to this.
PUBLIC_API_BASE_URL=http://localhost:3000
# Deep link the Android app registers; the hosted page redirects here on done.
PAYMENT_RETURN_DEEP_LINK=findmybay://payment/return

# Telr (only used when PAYMENT_PROVIDER=telr; sandbox by default)
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_TEST_MODE=true

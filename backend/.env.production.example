# Find My Bay — production env template.
# Copy to .env.production (or paste each line into your secret manager) and
# fill in the values. NEVER commit a filled-in copy.
#
# Generate strong JWT/HMAC values with:
#   npx tsx scripts/gen-prod-secrets.ts

# ─── Server ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────
# Format: postgresql://USER:PASS@HOST:PORT/DB?schema=public&sslmode=require
# Example for AWS RDS me-central-1 (Bahrain):
#   postgresql://fmb:<POSTGRES_PASSWORD>@<rds-endpoint>:5432/findmybay?sslmode=require
DATABASE_URL=

# ─── Redis (BullMQ + cache) ──────────────────────────────────────────
# Optional today; required when we move the alert worker to BullMQ.
# AWS ElastiCache TLS endpoint or DO Managed Redis.
REDIS_URL=

# ─── JWT ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ─── OTP ─────────────────────────────────────────────────────────────
# `unifonic` for production. Sender ID `FINDMYBAY` must be pre-approved.
OTP_DELIVERY=unifonic
OTP_TTL_MIN=5
OTP_RESEND_COOLDOWN_SEC=30
OTP_MAX_ATTEMPTS=5

# Unifonic credentials (from console.unifonic.com)
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=FINDMYBAY

# ─── CORS ────────────────────────────────────────────────────────────
# Lock down to the production frontends only. No wildcard.
CORS_ORIGINS=https://findmybay.ae,https://admin.findmybay.ae

# ─── Maps & Push ─────────────────────────────────────────────────────
# Restricted to the api.findmybay.ae HTTP referrer in Google Cloud console.
GOOGLE_MAPS_API_KEY=
# Path to the Firebase service account JSON inside your container/secret mount.
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json
# Web OAuth Client ID auto-created by Firebase when you add an Android app.
# Find it in Google Cloud Console → APIs & Services → Credentials → look for
# "Web client (auto created by Google Service)". Same value goes into the
# Android app's BuildConfig.GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=

# ─── Payments ────────────────────────────────────────────────────────
# `telr` for the pilot. Switch to `ni` once Network International merchant
# onboarding completes.
PAYMENT_PROVIDER=telr
PUBLIC_API_BASE_URL=https://api.findmybay.ae
PAYMENT_RETURN_DEEP_LINK=findmybay://payment/return

# Telr — from secure.telr.com → Merchant → Channels → Mobile/HSP
TELR_STORE_ID=
TELR_AUTH_KEY=
TELR_TEST_MODE=false

# ─── Observability ───────────────────────────────────────────────────
# Sentry DSN (backend project)
SENTRY_DSN=
# OpenTelemetry endpoint (Grafana Cloud / Honeycomb / etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
